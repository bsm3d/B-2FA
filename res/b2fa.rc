#include <windows.h>

1 ICON "b2fa.ico"
1 RT_MANIFEST "b2fa.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "BSM3D"
            VALUE "FileDescription", "B-2FA, your 2FAS codes on your PC"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "B-2FA"
            VALUE "LegalCopyright", "Copyright (C) 2026 Benoit Saint-Moulin. GPL-3.0-or-later"
            VALUE "OriginalFilename", "B-2FA.exe"
            VALUE "ProductName", "B-2FA"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
